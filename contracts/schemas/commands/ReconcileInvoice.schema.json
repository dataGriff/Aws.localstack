{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.event-platform.local/schemas/commands/ReconcileInvoice.schema.json",
  "title": "ReconcileInvoice",
  "description": "Command: reconcile an invoice against a received payment. Handled by the reconcile-invoice handler.",
  "allOf": [
    { "$ref": "../envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "kind": { "const": "command" },
        "type": { "const": "ReconcileInvoice" },
        "schemaVersion": { "const": "1.0" },
        "data": {
          "type": "object",
          "properties": {
            "invoiceId": { "type": "string", "minLength": 1 },
            "paymentId": { "type": "string", "minLength": 1 },
            "amount": { "type": "integer", "minimum": 0, "description": "Minor currency units." },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          },
          "required": ["invoiceId", "paymentId", "amount", "currency"],
          "additionalProperties": false
        }
      },
      "required": ["kind", "type", "schemaVersion", "data"]
    }
  ]
}
